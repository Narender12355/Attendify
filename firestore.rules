rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(profilePath()); }
    function isTeacher() { return isMember() && get(profilePath()).data.role == 'teacher'; }

    // Profiles: a user reads their own; teachers read and manage all.
    // A teacher can self-register only with the secret code stored in config/teacher.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isTeacher());
      allow create: if isTeacher()
        || (request.auth.uid == userId
            && request.resource.data.role == 'teacher'
            && request.resource.data.inviteCode == get(/databases/$(database)/documents/config/teacher).data.code);
      allow update, delete: if isTeacher();
    }

    // Secret settings: never readable from the app. Rules read them internally.
    match /config/{docId} { allow read, write: if false; }

    // Shared academic data: everyone signed in reads, only teachers write.
    match /subjects/{id}  { allow read: if isMember(); allow write: if isTeacher(); }
    match /syllabus/{id}  { allow read: if isMember(); allow write: if isTeacher(); }
    match /timetable/{id} { allow read: if isMember(); allow write: if isTeacher(); }
    match /events/{id}    { allow read: if isMember(); allow write: if isTeacher(); }

    // Attendance: one document per student per class. Students read only their own.
    match /attendance/{id} {
      allow read: if isTeacher() || (isMember() && resource.data.studentId == request.auth.uid);
      allow write: if isTeacher();
    }

    // Syllabus progress: each student edits their own; teachers can read all.
    match /progress/{userId} {
      allow read: if isMember() && (request.auth.uid == userId || isTeacher());
      allow create, update: if isMember() && request.auth.uid == userId;
      allow delete: if isTeacher();
    }
  }
}
